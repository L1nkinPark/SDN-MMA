# Backend URL without /api. For Expo Go on a real phone, replace this with
# the computer's Wi-Fi IPv4 address, for example http://192.168.1.80:4000.
# Android emulator only: http://10.0.2.2:4000.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
# Google Maps key for Android development and release builds. Not needed in Expo Go. Never commit the real key.
GOOGLE_MAPS_API_KEY=
