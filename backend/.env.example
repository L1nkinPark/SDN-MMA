NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/studyspot
# Required: two different random secrets, each at least 32 characters.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
CLIENT_ORIGINS=http://localhost:3000,http://localhost:8081
CHECKIN_DURATION_MINUTES=120
STATUS_MIN_SAMPLES=2
STATUS_REFRESH_MS=60000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=StudySpot Admin
# Optional SMTP. Set HOST/FROM and, if required by your provider, USER/PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
